# Core LLM settings

OPENROUTER_API_KEY=
PINECONE_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAMES=["openrouter/free", "openai/gpt-5-nano"]
MODEL_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL_NAME=openai/text-embedding-3-small
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
TAVILY_API_KEY=

# Auth and tokens
# Generate JWT_SECRET yourself, e.g.: openssl rand -hex 32
# Never commit a real value here - this file is meant to be public.

TOKEN_BEARER_URL=/api/v1/auth/login
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINS=1500
REFRESH_TOKEN_EXPIRY_DAYS=1

# Database and vector store
# POSTGRES_PASSWORD below is a placeholder for local docker-compose use only -
# still change it for anything beyond your own machine.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection

# Frontend

BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
